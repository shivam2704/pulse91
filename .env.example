# Pulse91 Environment Configuration
# Copy this file to .env and populate your secrets

# Broker API Credentials (Optional - Defaults to Sandbox)
GROWW_API_KEY=
GROWW_API_SECRET=

DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# WhatsApp & Webhook Alerts (Optional)
